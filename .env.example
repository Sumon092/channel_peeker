# Public site URL (used for canonical URLs, sitemap, schema)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# YouTube Data API v3 key (Google Cloud project with the API enabled)
YOUTUBE_API_KEY=

# Upstash Redis (REST). Leave empty in dev to use an in-memory cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional per-bucket daily quota overrides (defaults: 10000 / 100 / 10000)
# YT_QUOTA_MAIN=10000
# YT_QUOTA_SEARCH=100
# YT_QUOTA_BATCH_STATS=10000

# Set to "true" only after YouTube approves the derived-metrics amendment (plan 3.2).
DERIVED_METRICS_APPROVED=false

# Google Gemini API key (aistudio.google.com) for the AI generator tools.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite).
# GEMINI_MODEL=

# Optional search-engine verification meta tags (Search Console / Bing Webmaster).
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
